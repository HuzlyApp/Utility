# xAI / Grok — used ONLY for vision OCR fallback, not for candidate analysis.
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.5
XAI_REASONING_EFFORT=high
XAI_TEMPERATURE=0
XAI_TIMEOUT_MS=180000
XAI_MAX_RETRIES=1

# Claude / Anthropic (required for analysis; Claude is the only active analysis provider)
CLAUDE_API_KEY=your_claude_api_key_here
# Recommended: claude-3-5-sonnet-20241022 or newer. Placeholder models will not work.
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Optional faster model for standard analyses (falls back to CLAUDE_MODEL when empty)
CLAUDE_FAST_MODEL=
# Reduced from 180000: most analyses complete well under 2 minutes after optimization
CLAUDE_TIMEOUT_MS=120000
# Reduced from 8192: large outputs slow generation and inflate latency
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0
# Extended thinking for Claude 3.7+; 0 disables thinking for speed
CLAUDE_THINKING_BUDGET=0
# Enable Anthropic structured-output beta for JSON reliability (1 or true)
CLAUDE_STRUCTURED_OUTPUT=1
# Enable extended thinking for complex cases (default false for speed)
CLAUDE_EXTENDED_THINKING=false

# Job Requirement Cache
# Caches normalized job requirements to avoid re-analyzing the same job for each candidate
JOB_CACHE_ENABLED=true
JOB_CACHE_TTL_DAYS=30

# Neon Database
# Get connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon MCP Server
# Get API key from: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=your_neon_api_key_here

# Application Settings
RECENT_EXPERIENCE_MONTHS=24
MAX_UPLOAD_MB=10

# Neon Auth (Managed Better Auth)
# Base URL of your hosted Neon Auth server (Neon Console > Auth)
NEON_AUTH_BASE_URL=https://your-project.neonauth.region.aws.neon.tech/neondb/auth
# 32+ character secret for signing the session-data cache cookie
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=change_me_at_least_32_characters_long

# Initial admin bootstrap (scripts/bootstrap-admin.mjs)
ADMIN_EMAIL=admin@utility.com
ADMIN_INITIAL_PASSWORD=admin2026!

# Default platform super admin bootstrap (scripts/seed-superadmin.mjs)
DEFAULT_SUPERADMIN_EMAIL=brasshr@admin.com
DEFAULT_SUPERADMIN_PASSWORD=brasshr2026!

# Image / OCR limits
MAX_IMAGE_DIMENSION=10000
OCR_MIN_CONFIDENCE=60
# Vision model used only as a controlled fallback when OCR/extraction fail
XAI_VISION_MODEL=grok-4.5
